# 8. Alpha-Beta Pruning

def minimax(depth, node, alpha, beta, maximizing, values):
    if depth == 3:
        return values[node]

    if maximizing:
        best = float('-inf')
        for i in range(2):
            val = minimax(depth + 1, node * 2 + i,
                          alpha, beta, False, values)
            best = max(best, val)
            alpha = max(alpha, best)

            if beta <= alpha:
                break
        return best

    else:
        best = float('inf')
        for i in range(2):
            val = minimax(depth + 1, node * 2 + i,
                          alpha, beta, True, values)
            best = min(best, val)
            beta = min(beta, best)

            if beta <= alpha:
                break
        return best


values = [3, 5, 6, 9, 1, 2, 0, -1]

result = minimax(0, 0, float('-inf'),
                 float('inf'), True, values)

print("Optimal Value:", result)
